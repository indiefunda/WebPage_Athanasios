{
  "name": "athanasios-desalermos",
  "version": "1.0.0",
  "description": "Athanasios Desalermos, MD, FESBGH — Gastroenterology & Hepatology, Athens. A modern editorial website.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "content": "node scripts/build-content.mjs && node scripts/split-paragraphs.mjs",
    "fonts": "node scripts/download-fonts.mjs",
    "images": "node scripts/prepare-images.mjs",
    "map": "node scripts/build-map.mjs",
    "icons": "node scripts/build-icons.mjs",
    "og": "node scripts/make-og.mjs",
    "assets": "npm run fonts && npm run images && npm run map && npm run icons",
    "qa": "node scripts/qa.mjs",
    "shots": "node scripts/shots.mjs",
    "deploy": "npm run build && firebase deploy --only hosting"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "playwright-core": "^1.64.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
