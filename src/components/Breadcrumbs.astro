---
import { langOf } from '../lib/i18n';

interface Item {
  label: string;
  href?: string;
}

interface Props {
  items: Item[];
  class?: string;
}

const { items, class: className = '' } = Astro.props;
const isEnglish = langOf(Astro.url.pathname) === 'en';
const homeHref = isEnglish ? '/en/' : '/';
const homeLabel = isEnglish ? 'Home' : 'Αρχική';
---

<nav class={`breadcrumbs ${className}`} aria-label={isEnglish ? 'Breadcrumb' : 'Διαδρομή πλοήγησης'}>
  <ol>
    <li><a href={homeHref}>{homeLabel}</a></li>
    {
      items.map((item, index) => (
        <li>
          {item.href && index < items.length - 1 ? (
            <a href={item.href}>{item.label}</a>
          ) : (
            <span aria-current="page">{item.label}</span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
