---
import Icon from './Icon.astro';
import { site } from '../data/site';
import { langOf } from '../lib/i18n';

interface Props {
  title?: string;
  text?: string;
  eyebrow?: string;
  primaryLabel?: string;
  primaryHref?: string;
  class?: string;
}

const isEnglish = langOf(Astro.url.pathname) === 'en';

const {
  title = isEnglish ? 'The next step is a conversation.' : 'Το επόμενο βήμα είναι μια συζήτηση.',
  text = isEnglish
    ? 'Book an appointment at the Marousi clinic or call us with any question.'
    : 'Κλείστε ραντεβού στο ιατρείο του Μαρούσι ή επικοινωνήστε τηλεφωνικά για οποιαδήποτε απορία.',
  eyebrow = isEnglish ? 'Appointments' : 'Ραντεβού',
  primaryLabel = isEnglish ? 'Book an appointment' : 'Κλείστε ραντεβού',
  primaryHref = isEnglish ? '/en/contact#rantevou' : '/epikoinonia#rantevou',
  class: className = '',
} = Astro.props;
---

<section class={`cta ${className}`}>
  <div class="container cta__inner">
    <div class="cta__copy">
      <p class="eyebrow"><span class="eyebrow__dot"></span>{eyebrow}</p>
      <h2>{title}</h2>
      <p>{text}</p>
    </div>

    <div class="cta__actions">
      <a class="btn btn--light" href={primaryHref}>
        {primaryLabel}
        <Icon name="arrow-up-right" size={15} />
      </a>
      <a class="cta__tel" href={`tel:+30${site.mobile}`}>
        <span class="cta__tel-label">{isEnglish ? 'Phone' : 'Τηλέφωνο'}</span>
        <span class="cta__tel-value">{site.mobileDisplay}</span>
      </a>
      <a class="cta__mail" href={`mailto:${site.email}`}>{site.email}</a>
    </div>
  </div>
</section>
