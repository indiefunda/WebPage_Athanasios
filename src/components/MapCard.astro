---
import Icon from './Icon.astro';
import { site } from '../data/site';
import { siteEn } from '../data/en/site';
import { langOf } from '../lib/i18n';

const isEnglish = langOf(Astro.url.pathname) === 'en';
const clinic = isEnglish ? siteEn : site;
---

<figure class="map-card">
  <a
    class="map-card__link"
    href={clinic.mapsUrl}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={isEnglish ? 'Open the clinic address in maps' : 'Άνοιγμα της διεύθυνσης του ιατρείου στους χάρτες'}
  >
    <img
      src="/images/map-marousi.jpg"
      srcset="/images/map-marousi-800.jpg 800w, /images/map-marousi.jpg 1600w"
      sizes="(min-width: 1000px) 54vw, 94vw"
      width="1600"
      height="720"
      alt={isEnglish ? `Map of the clinic area: ${clinic.addressOneLine}` : `Χάρτης της περιοχής του ιατρείου: ${clinic.addressOneLine}`}
      loading="lazy"
      decoding="async"
    />
    <span class="map-card__tag">
      <Icon name="pin" size={14} />
      {clinic.address.street}, {clinic.address.locality}
    </span>
    <span class="map-card__cta">
      {isEnglish ? 'Directions in maps' : 'Οδηγίες στους χάρτες'}
      <Icon name="arrow-up-right" size={14} />
    </span>
  </a>
  <figcaption class="map-card__caption">
    <span>{clinic.addressOneLine}</span>
    <span>Map © OpenStreetMap contributors</span>
  </figcaption>
</figure>
