---
import Pic from './Pic.astro';
import { procedureCategoryLabel } from '../data/taxonomy';
import { procedureCategoryLabelEn } from '../data/en/taxonomy';
import { langOf } from '../lib/i18n';
import type { Procedure } from '../data/types';

interface Props {
  procedure: Procedure;
}

const { procedure } = Astro.props;
const isEnglish = langOf(Astro.url.pathname) === 'en';
const categoryLabel = isEnglish
  ? procedureCategoryLabelEn(procedure.category)
  : procedureCategoryLabel(procedure.category);
---

<a class="entry-card" href={isEnglish ? `/en/procedures/${procedure.slug}` : `/epemvaseis/${procedure.slug}`} data-reveal>
  <div class="entry-card__media">
    <Pic
      name={procedure.image}
      sizes="(min-width: 1000px) 30vw, (min-width: 620px) 45vw, 92vw"
    />
  </div>
  <div>
    <p class="entry-card__meta">{categoryLabel}</p>
    <h3>{procedure.title}</h3>
    <p>{procedure.short}</p>
  </div>
</a>
