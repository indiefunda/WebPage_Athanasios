---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Icon from '../../../components/Icon.astro';
import PageHero from '../../../components/PageHero.astro';
import CtaSection from '../../../components/CtaSection.astro';
import { conditionsEn } from '../../../data/en/conditions';
import {
  conditionCategoriesEn,
  conditionCategoryLabelEn,
  groupConditionsEn,
} from '../../../data/en/taxonomy';
import { priorityRank } from '../../../data/taxonomy';
import '../../../styles/pages.css';

const groups = groupConditionsEn(conditionsEn).map((group) => ({
  ...group,
  items: [...group.items].sort(
    (a, b) => priorityRank(a.slug) - priorityRank(b.slug) || a.title.localeCompare(b.title, 'en'),
  ),
}));

const countByCategory = (key: string) =>
  conditionsEn.filter((condition) => condition.category === key).length;
---

<BaseLayout
  title="Conditions — Gastroenterology & Hepatology"
  description="Gastroenterology and hepatology conditions: symptoms, diagnosis and treatment — from prevention to the most specialized conditions."
>
  <PageHero
    eyebrow="Conditions"
    index="04"
    title="The whole gut<br />and the liver."
    lede="A wide range of gastroenterology and hepatology conditions — with clear information on symptoms, diagnosis and treatment."
    crumbs={[{ label: 'Conditions' }]}
  />

  <section class="directory">
    <div class="container">
      <div class="directory__toolbar">
        <div class="search-field">
          <label class="visually-hidden" for="condition-search-en">Search conditions</label>
          <input
            id="condition-search-en"
            type="search"
            placeholder="Search: heartburn, liver, Crohn…"
            autocomplete="off"
            data-search
          />
          <Icon name="search" size={17} />
        </div>

        <div class="filter-chips" role="group" aria-label="Filter by category">
          <button class="filter-chip" type="button" data-filter="all" aria-pressed="true">
            All
            <span>{String(conditionsEn.length).padStart(2, '0')}</span>
          </button>
          {
            conditionCategoriesEn.map((category) => (
              <button
                class="filter-chip"
                type="button"
                data-filter={category.key}
                aria-pressed="false"
              >
                {category.label}
                <span>{String(countByCategory(category.key)).padStart(2, '0')}</span>
              </button>
            ))
          }
        </div>

        <div class="directory__meta">
          <p class="directory__count" data-count aria-live="polite">
            {conditionsEn.length} conditions
          </p>
          <p class="directory__hint">Select a condition for more information.</p>
        </div>
      </div>

      {
        groups.map((group) => (
          <section class="dir-group" id={group.key} data-group={group.key} aria-labelledby={`group-en-${group.key}`}>
            <div class="dir-group__head">
              <h2 id={`group-en-${group.key}`}>{group.label}</h2>
              <p>{group.description}</p>
              <span class="dir-group__count">{String(group.items.length).padStart(2, '0')}</span>
            </div>

            <div class="dir-list">
              {group.items.map((condition) => (
                <a
                  class="dir-row"
                  href={`/en/conditions/${condition.slug}`}
                  data-condition-row
                  data-category={condition.category}
                  data-search={`${condition.title} ${condition.short} ${conditionCategoryLabelEn(condition.category)}`.toLowerCase()}
                >
                  <span class="dir-row__main">
                    <h3>{condition.title}</h3>
                    <p>{condition.short}</p>
                  </span>
                  <span class="dir-row__arrow">
                    <Icon name="arrow-up-right" size={13} />
                  </span>
                </a>
              ))}
            </div>
          </section>
        ))
      }

      <p class="empty-state" data-empty hidden>
        No conditions found for those terms. Try a different search or choose “All”.
      </p>

      <div class="article-note" style="margin-top: 48px;">
        <p class="article-note__label">
          <Icon name="stethoscope" size={16} />
          Important note
        </p>
        <p>
          This information is educational and does not replace individualized medical advice. Read the
          <a href="/en/disclaimer"> disclaimer</a>.
        </p>
      </div>
    </div>
  </section>

  <CtaSection
    eyebrow="Appointments"
    title="Not sure what is bothering you?"
    text="The right diagnosis starts with a detailed discussion of your history and symptoms. Book an appointment for assessment."
  />
</BaseLayout>

<script>
  const normalize = (value: string) =>
    value
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .toLowerCase()
      .trim();

  const rows = Array.from(document.querySelectorAll<HTMLElement>('[data-condition-row]'));
  const groups = Array.from(document.querySelectorAll<HTMLElement>('[data-group]'));
  const search = document.querySelector<HTMLInputElement>('[data-search]');
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter]'));
  const count = document.querySelector<HTMLElement>('[data-count]');
  const empty = document.querySelector<HTMLElement>('[data-empty]');

  let activeCategory = 'all';

  const apply = () => {
    const query = normalize(search?.value ?? '');
    let visible = 0;

    rows.forEach((row) => {
      const matchesCategory =
        activeCategory === 'all' || row.dataset.category === activeCategory;
      const matchesText = !query || normalize(row.dataset.search ?? '').includes(query);
      const show = matchesCategory && matchesText;
      row.hidden = !show;
      if (show) visible += 1;
    });

    groups.forEach((group) => {
      const countInGroup = group.querySelectorAll('[data-condition-row]:not([hidden])').length;
      group.hidden = countInGroup === 0;
    });

    if (count) {
      count.textContent = `${visible} ${visible === 1 ? 'condition' : 'conditions'}`;
    }
    if (empty) empty.hidden = visible > 0;
  };

  search?.addEventListener('input', apply);

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      activeCategory = chip.dataset.filter ?? 'all';
      chips.forEach((item) => item.setAttribute('aria-pressed', String(item === chip)));
      apply();
    });
  });

  apply();
</script>
