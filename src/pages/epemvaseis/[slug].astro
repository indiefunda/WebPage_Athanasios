---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { procedures } from '../../data/procedures';
import { conditions } from '../../data/conditions';
import { procedureCategoryLabel, relatedConditions } from '../../data/taxonomy';
import type { Procedure } from '../../data/types';

export function getStaticPaths() {
  return procedures.map((procedure) => ({
    params: { slug: procedure.slug },
    slug: procedure.slug,
    props: { procedure },
  }));
}

const { procedure } = Astro.props as { procedure: Procedure };
const related = relatedConditions(procedure, conditions);
const more = procedures
  .filter((item) => item.category === procedure.category && item.slug !== procedure.slug)
  .slice(0, 3)
  .map((item) => ({
    title: item.title,
    href: `/epemvaseis/${item.slug}`,
    short: item.short,
  }));

const note =
  'Οι οδηγίες προετοιμασίας, η καταστολή και η μετά την εξέταση φροντίδα δίνονται εξατομικευμένα. Επικοινωνήστε με το ιατρείο για οποιαδήποτε απορία πριν ή μετά την επέμβαση.';
---

<ArticleLayout
  title={procedure.title}
  short={procedure.short}
  category={procedureCategoryLabel(procedure.category)}
  image={procedure.image}
  paragraphs={procedure.paragraphs}
  references={procedure.references}
  crumbs={[
    { label: 'Επεμβάσεις', href: '/epemvaseis' },
    { label: procedure.title },
  ]}
  indexPath="/epemvaseis"
  indexLabel="Επεμβάσεις"
  relatedTitle="Σχετικές παθήσεις"
  related={related.map((condition) => ({
    title: condition.title,
    href: `/pathiseis/${condition.slug}`,
    short: condition.short,
  }))}
  more={more}
  moreTitle="Σχετικές επεμβάσεις"
  note={note}
  schema={{
    about: { '@type': 'MedicalProcedure', name: procedure.title },
    specialty: { '@type': 'MedicalSpecialty', name: 'Gastroenterologic' },
  }}
/>
