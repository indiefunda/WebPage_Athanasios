---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProcedureEntry from '../../components/ProcedureEntry.astro';
import Icon from '../../components/Icon.astro';
import PageHero from '../../components/PageHero.astro';
import CtaSection from '../../components/CtaSection.astro';
import { procedures } from '../../data/procedures';
import { procedureCategories } from '../../data/taxonomy';
import '../../styles/pages.css';

const featured = procedures.filter((procedure) => procedure.featured);
const secondary = procedures.filter((procedure) => !procedure.featured);
---

<BaseLayout
  title="Επεμβάσεις — Κολονοσκόπηση, γαστροσκόπηση & εξετάσεις"
  description="Κολονοσκόπηση, γαστροσκόπηση, κάψουλα λεπτού εντέρου, μανομετρία και pH-μετρία στο ιατρείο του Αθανάσιου Δεσαλέρμου στην Αθήνα."
>
  <PageHero
    eyebrow="Επεμβάσεις"
    index="03"
    title="Διαγνωστικές<br />και θεραπευτικές<br />επεμβάσεις."
    lede="Κολονοσκόπηση, γαστροσκόπηση, κάψουλα λεπτού εντέρου, μανομετρία και pH-μετρία — με έμφαση στην πρόληψη και στη λειτουργική διάγνωση."
    crumbs={[{ label: 'Επεμβάσεις' }]}
  />

  <section class="directory">
    <div class="container">
      <div class="directory__toolbar">
        <div class="directory__meta">
          <p class="directory__count">{procedures.length} επεμβάσεις</p>
          <p class="directory__hint">
            Οι βασικές εξετάσεις πρώτα· οι εξειδικευμένες διαδικασίες στη συνέχεια.
          </p>
        </div>
        <ul class="filter-legend">
          {
            procedureCategories.map((category) => (
              <li>
                <span>{category.label}</span>
                {String(procedures.filter((procedure) => procedure.category === category.key).length).padStart(2, '0')}
              </li>
            ))
          }
        </ul>
      </div>

      <section class="category-block" style="margin-top: 0;">
        <div class="category-block__head">
          <h2>Προτεινόμενες εξετάσεις</h2>
          <p>Οι εξετάσεις στις οποίες δίνουμε έμφαση.</p>
        </div>
        <div class="entry-grid">{featured.map((procedure) => <ProcedureEntry procedure={procedure} />)}</div>
      </section>

      <section class="category-block">
        <div class="category-block__head">
          <h2>Εξειδικευμένες εξετάσεις</h2>
          <p>Συμπληρωματικές διαδικασίες για ειδικές ενδείξεις.</p>
        </div>
        <div class="entry-grid">{secondary.map((procedure) => <ProcedureEntry procedure={procedure} />)}</div>
      </section>

      <div class="article-note" style="margin-top: 56px;">
        <p class="article-note__label">
          <Icon name="stethoscope" size={16} />
          Πριν την επέμβαση
        </p>
        <p>
          Οι οδηγίες προετοιμασίας, η καταστολή και η διαδικασία συζητούνται εξατομικευμένα πριν από
          κάθε εξέταση. Επικοινωνήστε με το ιατρείο για οποιαδήποτε απορία.
        </p>
      </div>
    </div>
  </section>

  <CtaSection
    eyebrow="Ραντεβού"
    title="Χρειάζεστε μια εξέταση;"
    text="Κλείστε ραντεβού για να συζητήσουμε την κατάλληλη διαδικασία, την προετοιμασία και τον χρόνο που χρειάζεται."
  />
</BaseLayout>
