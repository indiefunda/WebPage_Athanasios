---
import BaseLayout from '../layouts/BaseLayout.astro';
import Pic from '../components/Pic.astro';
import Icon from '../components/Icon.astro';
import { site, journey, principles, institutions, credentials, authority } from '../data/site';
import { conditions } from '../data/conditions';
import { procedures } from '../data/procedures';
import { news } from '../data/news';
import { conditionCategories, procedureCategoryLabel } from '../data/taxonomy';
import '../styles/home.css';

const featuredConditions = conditions.filter((condition) => condition.featured).slice(0, 8);
const orderedProcedures = [...procedures].sort(
  (a, b) => Number(b.featured) - Number(a.featured),
);
const featuredNews = [...news].sort((a, b) => b.date.localeCompare(a.date))[0];

const formatDate = (iso: string) =>
  new Intl.DateTimeFormat('el-GR', { day: 'numeric', month: 'long', year: 'numeric' }).format(
    new Date(iso),
  );

const countByCategory = (key: string) =>
  conditions.filter((condition) => condition.category === key).length;
---

<BaseLayout>
  <!-- Hero -->
  <section class="hero">
    <div class="hero__ring" aria-hidden="true"></div>

    <div class="container hero__inner">
      <div class="hero__copy">
        <p class="eyebrow hero__eyebrow" data-reveal>
          <span class="eyebrow__dot"></span>
          Γαστρεντερολογία · Ηπατολογία — Αθήνα
        </p>

        <h1 class="hero__title">
          <span data-reveal style="--i:1">Αθανάσιος</span>
          <span data-reveal style="--i:2">Δεσαλέρμος</span>
        </h1>

        <p class="hero__role" data-reveal style="--i:3">
          Γαστρεντερολόγος – Ηπατολόγος
        </p>

        <p class="hero__alma" data-reveal style="--i:3">
          Απόφοιτος Ιατρικής Σχολής Αθηνών
        </p>

        <p class="hero__academic" data-reveal style="--i:3">
          Επίκουρος Καθηγητής Γαστρεντερολογίας, UMass Chan Medical School
        </p>

        <p class="hero__credentials" data-reveal style="--i:3">MD, FESBGH</p>

        <p class="hero__lede" data-reveal style="--i:4">
          Διεθνής εκπαίδευση, σύγχρονη τεχνολογία και προσωπική φροντίδα για τα πεπτικά και
          ηπατικά προβλήματα — με έδρα το Μαρούσι.
        </p>

        <div class="hero__actions" data-reveal style="--i:5">
          <a class="btn" href="/epikoinonia#rantevou">
            Κλείστε ραντεβού
            <Icon name="arrow-up-right" size={15} />
          </a>
          <a class="btn btn--ghost" href="/o-iatros">Ο ιατρός</a>
        </div>
      </div>

      <div class="hero__media" data-reveal="fade" style="--i:2">
        <div class="hero__arch">
          <div class="hero__arch-inner">
            <Pic
              name="portrait"
              sizes="(min-width: 900px) 34vw, 90vw"
              loading="eager"
              fetchpriority="high"
            />
          </div>
        </div>

        <div class="hero__seal" aria-hidden="true">
          <svg viewBox="0 0 108 108">
            <defs>
              <path id="seal-top" d="M10,54 A44,44 0 0 1 98,54"></path>
              <path id="seal-bottom" d="M10,54 A44,44 0 0 0 98,54"></path>
            </defs>
            <text>
              <textPath href="#seal-top" startOffset="50%" text-anchor="middle">
                ΚΑΤΟΠΙΝ ΡΑΝΤΕΒΟΥ
              </textPath>
            </text>
            <text>
              <textPath href="#seal-bottom" startOffset="50%" text-anchor="middle">
                ΑΘΗΝΑ · ΜΑΡΟΥΣΙ
              </textPath>
            </text>
          </svg>
          <span class="hero__seal-core"></span>
        </div>

        <div class="hero__badge">
          <p class="hero__badge-label">Διευθυντής</p>
          <p class="hero__badge-text">
            Γαστρεντερολογική – Ηπατολογική Κλινική, Ιατρικό Κέντρο Αθηνών
          </p>
        </div>
      </div>
    </div>

    <div class="container hero__foot">
      <ul class="hero__trust">
        <li>Harvard Medical School</li>
        <li>UC San Diego</li>
        <li>UMass Chan</li>
      </ul>
      <a class="hero__scroll" href="#prosengisi">
        Περισσότερα
        <i aria-hidden="true"></i>
      </a>
    </div>
  </section>

  <!-- Institutions -->
  <div class="marquee" aria-label="Εκπαίδευση και συνεργασίες">
    <div class="marquee__track">
      {
        [0, 1].map((groupIndex) => (
          <div class="marquee__group" aria-hidden={groupIndex === 1 ? 'true' : undefined}>
            {institutions.map((institution) => (
              <span class="marquee__item">{institution}</span>
            ))}
          </div>
        ))
      }
    </div>
  </div>

  <!-- US training and international practice -->
  <section class="authority">
    <div class="container authority__inner">
      <div class="authority__copy">
        <p class="eyebrow" data-reveal>
          <span class="eyebrow__dot"></span>
          {authority.eyebrow}
        </p>
        <h2 data-reveal style="--i:1">{authority.title}</h2>
        <p class="authority__text" data-reveal style="--i:2">{authority.text}</p>
      </div>

      <ul class="authority__points" data-reveal style="--i:3">
        {
          authority.points.map((point) => (
            <li>
              <span>{point.num}</span>
              <b>{point.title}</b>
              <em>{point.detail}</em>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Approach -->
  <section class="section" id="prosengisi">
    <div class="container">
      <div class="section-head">
        <div class="section-head__top">
          <p class="eyebrow" data-reveal>
            <span class="eyebrow__num">01</span>
            Η προσέγγιση
          </p>
          <h2 data-reveal style="--i:1">Ακριβής διάγνωση.<br />Ανθρώπινη φροντίδα.</h2>
        </div>
        <p class="section-head__aside" data-reveal style="--i:2">
          Η φροντίδα δεν ξεκινά από την εξέταση, αλλά από τη συζήτηση. Ακούμε το ιστορικό,
          εξηγούμε τα ευρήματα και σχεδιάζουμε μαζί το επόμενο βήμα.
        </p>
      </div>

      <div class="approach__body">
        <blockquote class="approach__quote" data-reveal>
          «Κάθε σύμπτωμα έχει τη δική του ιστορία. Η δουλειά μας είναι να τη διαβάσουμε σωστά.»
        </blockquote>

        <div class="approach__text" data-reveal style="--i:1">
          <p>
            Στο ιατρείο του κ. Δεσαλέρμου, η σύγχρονη τεχνολογία δεν υποκαθιστά τη σχέση με τον
            ασθενή — τη στηρίζει. Οι ενδοσκοπήσεις, το EndoFLIP, το FibroScan και η κάψουλα
            ενδοσκόπησης χρησιμοποιούνται με έναν στόχο: τη σωστή διάγνωση, χωρίς περιττές
            εξετάσεις.
          </p>
          <p>
            Από την πρώτη επίσκεψη έως την παρακολούθηση, η προσέγγιση είναι εξατομικευμένη. Οι
            επιλογές θεραπείας εξηγούνται με σαφήνεια και προσαρμόζονται στις ανάγκες, στην ηλικία
            και στον τρόπο ζωής κάθε ανθρώπου.
          </p>
          <p class="signature">
            <span>Αθανάσιος Δεσαλέρμος</span>
            <span>MD, FESBGH</span>
          </p>
        </div>
      </div>

      <ul class="principles">
        {
          principles.map((principle, index) => (
            <li class="principle" data-reveal style={`--i:${index}`}>
              <span class="principle__num">{principle.num}</span>
              <h3>{principle.title}</h3>
              <p>{principle.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- About preview -->
  <section class="section about-preview">
    <div class="container about-preview__grid">
      <div class="about-preview__media" data-reveal="fade">
        <div class="about-preview__frame">
          <Pic
            name="portrait-crossed"
            sizes="(min-width: 900px) 32vw, 90vw"
            class="pic"
          />
        </div>
        <p class="about-preview__caption">
          <span>Αθανάσιος Δεσαλέρμος</span>
          <span>Αθήνα</span>
        </p>
      </div>

      <div class="about-preview__content">
        <p class="eyebrow" data-reveal>
          <span class="eyebrow__num">02</span>
          Ο Ιατρός
        </p>
        <h2 data-reveal style="--i:1">Μια πορεία με διεθνή ορίζοντα.</h2>
        <p class="lede" data-reveal style="--i:2">
          Διευθυντής της Γαστρεντερολογικής – Ηπατολογικής Κλινικής στο Ιατρικό Κέντρο Αθηνών,
          επίκουρος καθηγητής στο UMass Chan Medical School και διατηρεί κλινική στο Ιλινόις.
        </p>
        <p data-reveal style="--i:3">
          Ο κ. Δεσαλέρμος αποφοίτησε από την Ιατρική Σχολή Αθηνών το 2007. Στις Ηνωμένες Πολιτείες
          εκπαιδεύτηκε στην εσωτερική παθολογία στο Boston University και στη γαστρεντερολογία –
          ηπατολογία στο UC San Diego, ενώ εργάστηκε ως μεταδιδακτορικός ερευνητής στο Harvard
          Medical School.
        </p>

        <dl class="credential-list">
          {
            credentials.map((credential, index) => (
              <div class="credential" data-reveal style={`--i:${index}`}>
                <dt>{credential.title}</dt>
                <dd>{credential.detail}</dd>
              </div>
            ))
          }
        </dl>

        <a class="link-arrow" href="/o-iatros">
          Πλήρες βιογραφικό
          <Icon name="arrow-right" size={15} />
        </a>
      </div>
    </div>
  </section>

  <!-- Procedures -->
  <section class="section section--ink procedures">
    <div class="container">
      <div class="section-head">
        <div class="section-head__top">
          <p class="eyebrow" data-reveal>
            <span class="eyebrow__num">03</span>
            Επεμβάσεις
          </p>
          <h2 data-reveal style="--i:1">Διάγνωση και θεραπεία,<br />με ακρίβεια.</h2>
        </div>
        <p class="section-head__aside" data-reveal style="--i:2">
          Κολονοσκόπηση, γαστροσκόπηση και κάψουλα λεπτού εντέρου, μαζί με μανομετρία και
          pH-μετρία: οι βασικοί άξονες διάγνωσης και πρόληψης. Το EndoFLIP και το FibroScan
          παραμένουν διαθέσιμα ως εξειδικευμένες επιλογές.
        </p>
      </div>

      <div class="proc-grid">
        {
          orderedProcedures.map((procedure, index) => (
            <a
              class="proc-card"
              href={`/epemvaseis/${procedure.slug}`}
              data-reveal
              style={`--i:${index % 3}`}
            >
              <div class="proc-card__media">
                <Pic
                  name={procedure.image}
                  sizes="(min-width: 1000px) 30vw, (min-width: 620px) 45vw, 92vw"
                />
              </div>
              <div class="proc-card__body">
                <div class="proc-card__meta">
                  <span>{String(index + 1).padStart(2, '0')}</span>
                  <span>{procedureCategoryLabel(procedure.category)}</span>
                </div>
                <h3>{procedure.title}</h3>
                <p>{procedure.short}</p>
              </div>
            </a>
          ))
        }
      </div>

      <p class="proc-hint" aria-hidden="true">
        Σύρετε για να δείτε όλες τις επεμβάσεις
        <span>→</span>
      </p>

      <div class="procedures__foot">
        <a class="link-arrow" href="/epemvaseis">
          Όλες οι επεμβάσεις
          <Icon name="arrow-right" size={15} />
        </a>
      </div>
    </div>
  </section>

  <!-- Conditions -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div class="section-head__top">
          <p class="eyebrow" data-reveal>
            <span class="eyebrow__num">04</span>
            Παθήσεις
          </p>
          <h2 data-reveal style="--i:1">Από την πρόληψη<br />στη φλεγμονώδη νόσο.</h2>
        </div>
        <p class="section-head__aside" data-reveal style="--i:2">
          Ξεκινήστε από εδώ: κολονοσκόπηση, γαστροσκόπηση, διάρροια, γαστροοισοφαγική
          παλινδρόμηση, Barrett, νόσος Crohn και ελκώδης κολίτιδα.
        </p>
      </div>

      <div class="screen-band" data-reveal>
        <a class="screen-card" href="/epemvaseis/kolonoskophsh">
          <span class="screen-card__label">Προληπτικός έλεγχος</span>
          <span class="screen-card__title">Κολονοσκόπηση</span>
          <span class="screen-card__text">Πρόληψη καρκίνου παχέος εντέρου</span>
          <Icon name="arrow-up-right" size={16} />
        </a>
        <a class="screen-card" href="/epemvaseis/anwterh-endoskophsh">
          <span class="screen-card__label">Προληπτικός έλεγχος</span>
          <span class="screen-card__title">Γαστροσκόπηση</span>
          <span class="screen-card__text">Οισοφάγος, στόμαχος, δωδεκαδάκτυλο</span>
          <Icon name="arrow-up-right" size={16} />
        </a>
      </div>

      <div class="condition-chips">
        {
          conditionCategories.map((category) => (
            <a class="condition-chip" href={`/pathiseis#${category.key}`}>
              {category.label}
              <span>{String(countByCategory(category.key)).padStart(2, '0')}</span>
            </a>
          ))
        }
      </div>

      <div class="condition-list">
        {
          featuredConditions.map((condition, index) => (
            <a
              class="condition-row"
              href={`/pathiseis/${condition.slug}`}
              data-reveal
              style={`--i:${index % 2}`}
            >
              <span class="condition-row__main">
                <h3>{condition.title}</h3>
                <p>{condition.short}</p>
              </span>
              <span class="condition-row__arrow">
                <Icon name="arrow-up-right" size={14} />
              </span>
            </a>
          ))
        }
      </div>

      <div class="conditions__foot">
        <a class="btn" href="/pathiseis">
          Όλες οι {conditions.length} παθήσεις
          <Icon name="arrow-right" size={15} />
        </a>
        <a class="btn btn--ghost" href="/epemvaseis">Επεμβάσεις</a>
      </div>
    </div>
  </section>

  <!-- Journey -->
  <section class="section journey">
    <div class="container">
      <div class="section-head">
        <div class="section-head__top">
          <p class="eyebrow" data-reveal>
            <span class="eyebrow__num">05</span>
            Η διαδρομή
          </p>
          <h2 data-reveal style="--i:1">Από την Αθήνα<br />στη Βοστώνη — και πίσω.</h2>
        </div>
        <p class="section-head__aside" data-reveal style="--i:2">
          Δύο ήπειροι, τέσσερα κορυφαία πανεπιστήμια και μια σταθερή αρχή: η κλινική εμπειρία να
          υπηρετεί τον άνθρωπο απέναντι.
        </p>
      </div>

      <div class="journey__grid">
        <div class="journey__media" data-reveal="fade">
          <figure class="journey__figure-main">
            <Pic name="boston" sizes="(min-width: 900px) 38vw, 92vw" />
            <figcaption>Βοστώνη, ΗΠΑ</figcaption>
          </figure>
          <figure class="journey__figure-small">
            <Pic name="san-diego" sizes="(min-width: 900px) 22vw, 52vw" />
            <figcaption>Σαν Ντιέγκο</figcaption>
          </figure>
        </div>

        <ol class="journey__list">
          {
            journey.map((step, index) => (
              <li class="journey__item" data-reveal style={`--i:${index % 3}`}>
                <span class="journey__stage">{step.stage}</span>
                <div>
                  <p class="journey__place">{step.place}</p>
                  <h3>{step.title}</h3>
                  <p>{step.detail}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <!-- Clinic -->
  <section class="section clinic">
    <div class="container clinic__grid">
      <div class="clinic__content">
        <p class="eyebrow" data-reveal>
          <span class="eyebrow__num">06</span>
          Το Ιατρείο
        </p>
        <h2 data-reveal style="--i:1">Ήρεμο, διακριτικό,<br />στο Μαρούσι.</h2>
        <p class="lede" data-reveal style="--i:2">
          Ένας χώρος με την ησυχία και τη διακριτικότητα ενός ιδιωτικού ιατρείου, σχεδιασμένος για
          άνεση και ασφάλεια.
        </p>
        <p data-reveal style="--i:3" class="clinic__body">
          Με προσοχή στη λεπτομέρεια και φιλικό κλίμα, υποδεχόμαστε τους ασθενείς σε έναν χώρο που
          συνδυάζει την επιστημονική αρτιότητα με την προσωπική φροντίδα.
        </p>

        <dl class="clinic__facts" data-reveal style="--i:4">
          <div class="clinic__fact">
            <dt>Διεύθυνση</dt>
            <dd>{site.address.street}, {site.address.locality} {site.address.postalCode}</dd>
          </div>
          <div class="clinic__fact">
            <dt>Ραντεβού</dt>
            <dd>{site.bookNote}</dd>
          </div>
          <div class="clinic__fact">
            <dt>Τηλέφωνα</dt>
            <dd>
              <a href={`tel:+30${site.mobile}`}>{site.mobileDisplay}</a> ·{' '}
              <a href={`tel:+30${site.phone}`}>{site.phoneDisplay}</a>
            </dd>
          </div>
        </dl>

        <div class="clinic__actions">
          <a class="btn" href="/iatreio">
            Το ιατρείο
            <Icon name="arrow-up-right" size={15} />
          </a>
          <a class="btn btn--ghost" href={site.mapsUrl} target="_blank" rel="noopener noreferrer">
            Οδηγίες πρόσβασης
            <Icon name="external" size={14} />
          </a>
        </div>
      </div>

      <div class="clinic__gallery" data-reveal="fade">
        <figure class="clinic__shot clinic__shot--wide">
          <Pic name="clinic-1" sizes="(min-width: 900px) 52vw, 92vw" />
          <figcaption>Ο χώρος εξέτασης</figcaption>
        </figure>
        <figure class="clinic__shot">
          <Pic name="clinic-2" sizes="(min-width: 900px) 26vw, 46vw" />
          <figcaption>Ιατρείο</figcaption>
        </figure>
        <figure class="clinic__shot">
          <Pic name="clinic-3" sizes="(min-width: 900px) 26vw, 46vw" />
          <figcaption>Γραφείο</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- News -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div class="section-head__top">
          <p class="eyebrow" data-reveal>
            <span class="eyebrow__num">07</span>
            Άρθρα
          </p>
          <h2 data-reveal style="--i:1">Ενημέρωση για την<br />υγεία του πεπτικού.</h2>
        </div>
        <p class="section-head__aside" data-reveal style="--i:2">
          Άρθρα και σημειώσεις για συμπτώματα, εξετάσεις και καθημερινές συνήθειες που κάνουν τη
          διαφορά στην υγεία του εντέρου και του ήπατος.
        </p>
      </div>

      <a class="news-feature" href={`/nea/${featuredNews.slug}`} data-reveal>
        <div class="news-feature__media">
          <Pic
            name={featuredNews.image}
            sizes="(min-width: 860px) 55vw, 92vw"
          />
        </div>
        <div>
          <p class="news-feature__meta">
            <span>{featuredNews.category}</span>
            <span>{formatDate(featuredNews.date)}</span>
          </p>
          <h3>{featuredNews.title}</h3>
          <p>{featuredNews.excerpt}</p>
          <span class="link-arrow">
            Διαβάστε το άρθρο
            <Icon name="arrow-right" size={15} />
          </span>
        </div>
      </a>
    </div>
  </section>

  <!-- Contact -->
  <section class="contact-band" id="epikoinonia">
    <div class="container contact-band__inner">
      <div>
        <p class="eyebrow" data-reveal>
          <span class="eyebrow__num">08</span>
          Επικοινωνία
        </p>
        <h2 data-reveal style="--i:1">Το επόμενο βήμα<br />είναι μια συζήτηση.</h2>
        <p class="contact-band__aside" data-reveal style="--i:2">
          Κλείστε ραντεβού στο ιατρείο του Μαρούσι ή επικοινωνήστε τηλεφωνικά. Για επείγοντα
          περιστατικά, απευθυνθείτε στο πλησιέστερο νοσοκομείο.
        </p>
        <div class="contact-band__actions" data-reveal style="--i:3">
          <a class="btn btn--light" href="/epikoinonia#rantevou">
            Κλείστε ραντεβού
            <Icon name="arrow-up-right" size={15} />
          </a>
          <a class="btn btn--ghost-light" href={`tel:+30${site.mobile}`}>
            {site.mobileDisplay}
          </a>
        </div>
      </div>

      <div class="contact-band__rows" data-reveal style="--i:2">
        <a class="contact-band__row" href={`tel:+30${site.mobile}`}>
          <span class="contact-band__label">Κινητό</span>
          <span class="contact-band__value">{site.mobileDisplay}</span>
        </a>
        <a class="contact-band__row" href={`tel:+30${site.phone}`}>
          <span class="contact-band__label">Σταθερό</span>
          <span class="contact-band__value">{site.phoneDisplay}</span>
        </a>
        <a class="contact-band__row" href={`mailto:${site.email}`}>
          <span class="contact-band__label">Email</span>
          <span class="contact-band__value">{site.email}</span>
        </a>
        <a
          class="contact-band__row"
          href={site.mapsUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="contact-band__label">Διεύθυνση</span>
          <span class="contact-band__value">{site.addressOneLine}</span>
        </a>
        <p class="contact-band__note">{site.hours}</p>
      </div>
    </div>
  </section>
</BaseLayout>
