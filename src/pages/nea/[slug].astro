---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { news } from '../../data/news';
import { conditions } from '../../data/conditions';
import type { Post } from '../../data/types';

export function getStaticPaths() {
  return news.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props as { post: Post };

const formatDate = (iso: string) =>
  new Intl.DateTimeFormat('el-GR', { day: 'numeric', month: 'long', year: 'numeric' }).format(
    new Date(iso),
  );

const relatedSlugs = post.relatedConditions ?? [];

const related = conditions
  .filter((condition) => relatedSlugs.includes(condition.slug))
  .map((condition) => ({
    title: condition.title,
    href: `/pathiseis/${condition.slug}`,
    short: condition.short,
  }));

const more = [...news]
  .filter((article) => article.slug !== post.slug)
  .sort((a, b) => b.date.localeCompare(a.date))
  .map((article) => ({
    title: article.title,
    href: `/nea/${article.slug}`,
    short: article.excerpt,
  }));
---

<ArticleLayout
  title={post.title}
  short={post.excerpt}
  category={post.category}
  image={post.image}
  paragraphs={post.paragraphs}
  keyPoints={post.keyPoints ?? []}
  inlineImage={post.inlineImage}
  references={post.references}
  crumbs={[{ label: 'Άρθρα', href: '/nea' }, { label: 'Άρθρο' }]}
  indexPath="/nea"
  indexLabel="Άρθρα"
  backLabel="Όλα τα άρθρα"
  relatedTitle="Σχετικές παθήσεις"
  related={related}
  more={more}
  moreTitle="Περισσότερα άρθρα"
  metaLabel={formatDate(post.date)}
/>
