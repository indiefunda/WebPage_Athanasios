---
import Pic from '../components/Pic.astro';
import '../styles/fonts.css';
---

<!doctype html>
<html lang="el">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="viewport" content="width=1200" />
    <title>OG card — drdesalermos.gr</title>
    <style is:global>
      html,
      body {
        margin: 0;
        padding: 0;
        width: 1200px;
        height: 630px;
        overflow: hidden;
        background: #f3f0e8;
        color: #0f221c;
        font-family: 'Manrope', sans-serif;
      }

      .og {
        position: relative;
        width: 1200px;
        height: 630px;
        overflow: hidden;
      }

      .og::before {
        content: '';
        position: absolute;
        right: -160px;
        top: -280px;
        width: 760px;
        height: 760px;
        border: 1px solid rgba(15, 34, 28, 0.14);
        border-radius: 50%;
      }

      .og__left {
        position: absolute;
        left: 72px;
        top: 62px;
        width: 700px;
        z-index: 2;
      }

      .og__eyebrow {
        margin: 0;
        font-size: 12px;
        font-weight: 650;
        letter-spacing: 3.6px;
        text-transform: uppercase;
        color: #5b6a62;
      }

      .og__name {
        margin: 26px 0 0;
        font-family: 'GFS Didot', serif;
        font-size: 104px;
        line-height: 0.94;
        letter-spacing: -2px;
      }

      .og__role {
        margin: 24px 0 0;
        font-size: 19px;
        font-weight: 550;
        letter-spacing: 0.3px;
        color: #243b33;
        display: flex;
        align-items: center;
        gap: 16px;
      }

      .og__role::before {
        content: '';
        width: 42px;
        height: 1px;
        background: #b0522e;
      }

      .og__role span {
        font-size: 11px;
        font-weight: 650;
        letter-spacing: 2.2px;
        text-transform: uppercase;
        color: #5b6a62;
      }

      .og__rule {
        width: 100%;
        height: 1px;
        background: rgba(15, 34, 28, 0.16);
        margin: 40px 0 18px;
      }

      .og__inst {
        margin: 0;
        font-size: 11px;
        font-weight: 650;
        letter-spacing: 1.9px;
        text-transform: uppercase;
        color: #5b6a62;
      }

      .og__arch {
        position: absolute;
        right: 78px;
        bottom: 0;
        width: 380px;
        height: 505px;
        padding: 8px 8px 0;
        border: 1px solid rgba(15, 34, 28, 0.32);
        border-radius: 999px 999px 0 0;
        background: #faf8f2;
      }

      .og__arch-inner {
        width: 100%;
        height: 100%;
        overflow: hidden;
        border-radius: 999px 999px 0 0;
        background: #ded5c4;
      }

      .og__arch img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: 50% 14%;
      }

      .og__badge {
        position: absolute;
        left: 72px;
        bottom: 40px;
        z-index: 2;
        display: flex;
        align-items: center;
        gap: 12px;
        font-size: 11px;
        font-weight: 650;
        letter-spacing: 2.4px;
        text-transform: uppercase;
        color: #0f221c;
      }

      .og__badge::before {
        content: '';
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #b0522e;
      }

      .og__url {
        position: absolute;
        right: 78px;
        top: 56px;
        margin: 0;
        font-size: 11px;
        font-weight: 650;
        letter-spacing: 2.4px;
        text-transform: uppercase;
        color: #5b6a62;
      }
    </style>
  </head>

  <body>
    <main class="og">
      <div class="og__left">
        <p class="og__eyebrow">Γαστρεντερολογία · Ηπατολογία — Αθήνα</p>
        <p class="og__name">Αθανάσιος<br />Δεσαλέρμος</p>
        <p class="og__role">Γαστρεντερολόγος – Ηπατολόγος <span>MD · FESBGH</span></p>
        <div class="og__rule"></div>
        <p class="og__inst">Harvard Medical School · UC San Diego · UMass Chan</p>
      </div>

      <div class="og__arch">
        <div class="og__arch-inner">
          <Pic name="portrait" sizes="380px" loading="eager" />
        </div>
      </div>

      <p class="og__badge">Ιατρικό Κέντρο Αθηνών</p>
      <p class="og__url">drdesalermos.gr</p>
    </main>
  </body>
</html>
